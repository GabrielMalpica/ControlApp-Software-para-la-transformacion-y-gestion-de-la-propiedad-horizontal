# Hostinger. Este archivo vive en controlapp_frontend/web/ y Flutter lo copia
# a build/web en cada `flutter build web`: se sube junto con lo demás y no hay
# que editarlo a mano en el servidor.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el archivo o carpeta existe, lo sirve normal
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo lo demás va a index.html (para rutas de Flutter)
  RewriteRule ^ index.html [L]
</IfModule>

# Actualización automática de la app (docs/actualizacion-web.md). Estos
# archivos tienen el mismo nombre en cada versión; Hostinger los guardaba 7
# días en caché (max-age=604800), así que el navegador y el CDN seguían
# entregando la versión vieja. Con "no-cache" se pueden guardar, pero se
# revisan con el servidor cada vez: si no cambiaron, la respuesta es un 304
# de pocos bytes; si cambiaron, llega la versión nueva.
<FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter\.js|main\.dart\.js|manifest\.json|version\.json|AssetManifest\.bin|AssetManifest\.bin\.json|AssetManifest\.json|FontManifest\.json|MaterialIcons-Regular\.otf|CupertinoIcons\.ttf|NOTICES)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header unset Expires
  </IfModule>
</FilesMatch>

# Content-Security-Policy: limita lo que puede cargar y ejecutar la página si
# alguien logra inyectarle un script (docs/actualizacion-web.md, "Content-
# Security-Policy", explica cada fuente y cómo ampliarla).
#
# - La primera línea ya se aplica: nadie puede meter la app en un iframe
#   ajeno, ni usar <object>/<embed>, ni cambiar el <base> de la página.
# - La segunda es la política completa en modo "Report-Only": el navegador no
#   bloquea nada, solo avisa en la consola lo que habría bloqueado. Cuando en
#   producción no aparezcan avisos en los flujos principales, se pasa a
#   obligatoria (pasos en el documento).
#
# Después de cada `flutter build web` hay que correr
# `node scripts/csp-web.js --api <API_BASE_URL>`: el hash 'sha256-…' del
# arranque en línea cambia al actualizar Flutter o editar flutter_bootstrap.js.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-9i9JjpDe9zrtwIIXIISna/AmLyBRupY1tHQK7wJeU/M=' 'sha256-+M0fGRkOqgYlCQCff9oNQn6k6a7Si4Et8iofLMceadE=' https://www.gstatic.com/flutter-canvaskit/ https://unpkg.com/@zxing/library@0.21.3; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://controlsas.com.co; font-src 'self' https://fonts.gstatic.com/s/; connect-src 'self' https://api.controlsas.com.co https://controlsas.com.co https://www.gstatic.com/flutter-canvaskit/ https://fonts.gstatic.com/s/ blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
