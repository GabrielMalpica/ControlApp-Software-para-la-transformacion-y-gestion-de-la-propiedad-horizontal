/**
 * =========================================
 * MODELOS - COMERCIO / RESIDENTES
 * =========================================
 */

model Residente {
  id         String   @id
  usuario    Usuario  @relation(fields: [id], references: [id], onDelete: Cascade)
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  tipoUnidad TipoUnidadResidencial
  sector     String?
  unidad     String

  telefonoContacto String?
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  pedidos PedidoApp[] @relation("PedidoAppResidente")

  @@index([conjuntoId])
  @@index([conjuntoId, activo])
  @@map("Residente")
}

model PedidoApp {
  id        Int                 @id @default(autoincrement())
  tipo      TipoPedidoApp
  estado    EstadoPedidoInterno @default(BORRADOR)
  estadoWoo String?

  wooOrderId String?   @unique
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  conjuntoId String?
  conjunto   Conjunto? @relation(fields: [conjuntoId], references: [nit])

  residenteId String?
  residente   Residente? @relation("PedidoAppResidente", fields: [residenteId], references: [id])

  total              Decimal   @db.Decimal(14, 2)
  moneda             String    @default("COP")
  pagarAhora         Decimal   @default(0) @db.Decimal(14, 2)
  fechaServicio      DateTime? @db.Date
  turnoServicio      String?
  opcionPagoServicio String?
  addonsServicio     Json?
  idempotencyKey     String?   @unique

  // Verificacion de pago manual (aun no hay pasarela conectada): el
  // comprador elige metodo y sube su comprobante de transferencia; un
  // administrador/gerente lo revisa DENTRO de la app (no en WordPress) y
  // recien ahi puede pasar el pedido a PAGADO -ver el guard en
  // CommerceLifecycleService.transicionar.
  direccionEntrega    String?
  metodoPago          String?
  comprobanteUrl      String?
  comprobanteSubidoEn DateTime?
  // Lectura automatica (OCR) del comprobante -ayuda al revisor, no confirma el
  // pago por si sola-. Referencia y hash sirven para detectar el mismo
  // comprobante reutilizado en otro pedido.
  comprobanteReferencia   String?
  comprobanteHash         String?
  comprobanteVerificacion Json?

  entradaInventarioAplicada   Boolean   @default(false)
  entradaInventarioAplicadaEn DateTime?
  puntosAplicados             Boolean   @default(false)
  puntosAplicadosEn           DateTime?
  descuentoPuntos             Decimal   @default(0) @db.Decimal(14, 2)

  beneficioPuntos   BeneficioPuntos? @relation("PedidoBeneficioPuntos", fields: [beneficioPuntosId], references: [id], onDelete: SetNull)
  beneficioPuntosId Int?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  items              PedidoAppItem[]
  movimientosPuntos  MovimientoPuntos[]
  historialEstados   PedidoAppEstadoHistorico[]
  consumosInventario ConsumoInsumo[]            @relation("PedidoInventarioEntradas")

  @@index([usuarioId])
  @@index([usuarioId, estado])
  @@index([conjuntoId, estado])
  @@index([wooOrderId])
  @@index([comprobanteReferencia])
  @@index([comprobanteHash])
  @@map("PedidoApp")
}

model PedidoAppItem {
  id       Int       @id @default(autoincrement())
  pedido   PedidoApp @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId Int

  wooProductId       Int?
  wooVariationId     Int?
  // Factor de conversion declarado EN WOOCOMMERCE (campo propio del plugin,
  // ej. "este tarro trae 60 pastillas") al momento de comprar. Se guarda
  // aqui -no se relee de Woo durante la recepcion- para no depender de una
  // llamada HTTP dentro de la transaccion que aplica el inventario, y para
  // que quede fijo el valor con el que se compro aunque despues alguien
  // edite el campo en WordPress. Null = Woo no declaro nada para este
  // producto/variacion; en ese caso se usa el factor manual del Insumo
  // (Insumo.wooFactorConversion), como antes de este campo existir.
  wooFactorInventario Decimal? @db.Decimal(12, 4)
  nombreProducto     String
  sku                String?
  cantidad           Decimal   @db.Decimal(14, 4)
  precioUnitario     Decimal   @db.Decimal(14, 2)
  subtotal           Decimal   @db.Decimal(14, 2)
  pagarAhora         Decimal   @default(0) @db.Decimal(14, 2)
  fechaServicio      DateTime? @db.Date
  turnoServicio      String?
  opcionPagoServicio String?
  addonsServicio     Json?

  insumo   Insumo? @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  insumoId Int?

  // Lo que el cliente reporto al confirmar la recepcion: cuanto llego de lo
  // pedido (menos que "cantidad" = llego incompleto) y, opcional, que paso.
  // Solo lo recibido suma al inventario. Null = pedido anterior a este reporte.
  cantidadRecibida Decimal? @db.Decimal(14, 4)
  novedadRecepcion String?

  @@index([pedidoId])
  @@index([insumoId])
  @@map("PedidoAppItem")
}

model PedidoAppEstadoHistorico {
  id Int @id @default(autoincrement())

  pedido   PedidoApp @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId Int

  estadoAnterior EstadoPedidoInterno?
  estadoNuevo    EstadoPedidoInterno

  cambiadoPor    Usuario  @relation("PedidoEstadoCambiadoPor", fields: [cambiadoPorId], references: [id])
  cambiadoPorId  String
  cambiadoPorRol String
  motivo         String?
  creadoEn       DateTime @default(now())

  @@index([pedidoId, creadoEn])
  @@index([cambiadoPorId])
  @@map("PedidoAppEstadoHistorico")
}

model ConfigPuntosConjunto {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String   @unique

  activo                 Boolean @default(false)
  montoPorPuntoResidente Decimal @default(1000) @db.Decimal(14, 2)
  montoPorPuntoConjunto  Decimal @default(1000) @db.Decimal(14, 2)
  minimoRedencionPuntos  Int     @default(100)

  beneficios    BeneficioPuntos[]
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  @@map("ConfigPuntosConjunto")
}

model BeneficioPuntos {
  id Int @id @default(autoincrement())

  config   ConfigPuntosConjunto @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId Int

  nombre         String
  descripcion    String?
  puntosCosto    Int
  valorDescuento Decimal  @default(0) @db.Decimal(14, 2)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  movimientos MovimientoPuntos[]
  pedidos     PedidoApp[]        @relation("PedidoBeneficioPuntos")

  @@index([configId, activo])
  @@map("BeneficioPuntos")
}

model MovimientoPuntos {
  id        Int     @id @default(autoincrement())
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  pedido   PedidoApp? @relation(fields: [pedidoId], references: [id])
  pedidoId Int?

  conjunto   Conjunto? @relation(fields: [conjuntoId], references: [nit], onDelete: SetNull)
  conjuntoId String?

  beneficio   BeneficioPuntos? @relation(fields: [beneficioId], references: [id], onDelete: SetNull)
  beneficioId Int?

  tipo        TipoMovimientoPuntos
  puntos      Int
  descripcion String?

  creadoEn DateTime @default(now())

  @@index([usuarioId])
  @@index([usuarioId, creadoEn])
  @@index([usuarioId, conjuntoId, creadoEn])
  @@index([pedidoId, tipo])
  @@index([beneficioId])
  @@map("MovimientoPuntos")
}

/**
 * =========================================
 * MODELOS - PLAN ESPERANZA
 * =========================================
 */

model PlanEsperanzaConfig {
  id             Int      @id @default(autoincrement())
  conjunto       Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId     String   @unique
  intervaloMeses Int      @default(3)
  actualizadoEn  DateTime @updatedAt

  @@map("PlanEsperanzaConfig")
}

model PlanEsperanza {
  id           Int               @id @default(autoincrement())
  conjunto     Conjunto          @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId   String
  fechaInicio  DateTime          @default(now())
  fechaFin     DateTime?
  completado   Boolean           @default(false)
  creadoEn     DateTime          @default(now())
  diagnosticos DiagnosticoArea[]

  @@index([conjuntoId, completado])
  @@index([conjuntoId, fechaInicio])
  @@map("PlanEsperanza")
}

model DiagnosticoArea {
  id              Int           @id @default(autoincrement())
  planEsperanza   PlanEsperanza @relation(fields: [planEsperanzaId], references: [id], onDelete: Cascade)
  planEsperanzaId Int
  elemento        Elemento      @relation(fields: [elementoId], references: [id])
  elementoId      Int
  urlFoto         String?
  valoracion      Float?
  observaciones   String?
  checklist       Json?
  creadoEn        DateTime      @default(now())

  @@unique([planEsperanzaId, elementoId])
  @@index([elementoId])
  @@map("DiagnosticoArea")
}
