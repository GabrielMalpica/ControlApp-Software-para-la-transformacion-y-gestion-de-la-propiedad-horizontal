/**
 * =========================================
 * MODELOS - CONFIG / MAESTROS
 * =========================================
 */

model ConfiguracionSistema {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String
}

model ConfiguracionLaboral {
  id                    Int      @id @default(1)
  horasSemanalesLegales Int // 44 hoy, 42 mañana
  updatedAt             DateTime @updatedAt

  @@map("ConfiguracionLaboral")
}

/**
 * =========================================
 * MODELOS - NÚCLEO EMPRESA / USUARIOS / ROLES
 * =========================================
 */

model Usuario {
  id                       String  @id
  nombre                   String
  correo                   String  @unique
  contrasena               String
  rol                      String
  activo                   Boolean @default(true)
  requiereCambioContrasena Boolean @default(false)

  telefono        BigInt
  fechaNacimiento DateTime
  direccion       String?
  estadoCivil     EstadoCivil?
  numeroHijos     Int?
  padresVivos     Boolean?
  tipoSangre      TipoSangre?
  eps             EPS?
  fondoPensiones  FondoPension?
  tallaCamisa     TallaCamisa?
  tallaPantalon   TallaPantalon?
  tallaCalzado    TallaCalzado?
  tipoContrato    TipoContrato?

  jornadaLaboral JornadaLaboral?
  patronJornada  PatronJornada?

  gerente             Gerente?
  jefeOperaciones     JefeOperaciones?
  supervisor          Supervisor?
  operario            Operario?
  administrador       Administrador?
  residente           Residente?
  compromisosCreados  CompromisoConjunto[]       @relation("CompromisoCreadoPor")
  pedidos             PedidoApp[]
  movimientosPuntos   MovimientoPuntos[]
  cambiosEstadoPedido PedidoAppEstadoHistorico[] @relation("PedidoEstadoCambiadoPor")
  notificaciones      Notificacion[]
}

model Notificacion {
  id             Int       @id @default(autoincrement())
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo           String
  titulo         String
  mensaje        String
  referenciaTipo String?
  referenciaId   Int?
  data           Json?
  leida          Boolean   @default(false)
  leidaEn        DateTime? @db.Timestamptz(6)
  creadaEn       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([usuarioId, leida], map: "idx_notificacion_usuario_leida")
  @@index([usuarioId, creadaEn(sort: Desc)], map: "idx_notificacion_usuario_creada")
  @@map("Notificacion")
}

model Empresa {
  id                Int    @id @default(autoincrement())
  nombre            String
  nit               String @unique
  limiteHorasSemana Int    @default(42)

  // Roles
  gerentes         Gerente[]
  jefesOperaciones JefeOperaciones[]
  supervisores     Supervisor[]
  operarios        Operario[]

  // Clientes/Conjuntos
  conjuntos Conjunto[]

  // Catálogos/Stock
  stockMaquinaria Maquinaria[]
  tiposMaquinaria TipoMaquinariaCatalogo[]
  catalogoInsumos Insumo[]

  // Solicitudes
  solicitudesTareas     SolicitudTarea[]
  solicitudesInsumos    SolicitudInsumo[]
  solicitudesMaquinaria SolicitudMaquinaria[]

  // Flujo de aprobación/rechazo
  tareasAprobadas  Tarea[] @relation("EmpresaTareasAprobadas")
  tareasRechazadas Tarea[] @relation("EmpresaTareasRechazadas")

  // Analítica/consumos
  insumosConsumidos       InsumoConsumoEmpresa[]
  Rendimiento             Rendimiento[]
  catalogoHerramientas    Herramienta[]
  herramientasItems       HerramientaItem[]
  stockHerramientas       EmpresaHerramientaStock[]
  solicitudesHerramientas SolicitudHerramienta[]
  prestamosHerramientas   PrestamoHerramientaConjunto[]
  permisosRol             PermisoRol[]

  // Asistencia / novedades
  conceptosAsistencia ConceptoAsistencia[]
  turnosExtra         TurnoExtra[]

  @@map("Empresa")
}

model PermisoRol {
  id        Int      @id @default(autoincrement())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  rol       Rol
  permiso   String
  permitido Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, rol, permiso])
  @@index([empresaId, rol])
  @@map("PermisoRol")
}

model Gerente {
  id        String   @id
  usuario   Usuario  @relation(fields: [id], references: [id], onDelete: Cascade)
  empresa   Empresa? @relation(fields: [empresaId], references: [nit])
  empresaId String?

  @@map("Gerente")
}

model Administrador {
  id        String     @id
  usuario   Usuario    @relation(fields: [id], references: [id], onDelete: Cascade)
  conjuntos Conjunto[]

  @@map("Administrador")
}

model JefeOperaciones {
  id      String  @id
  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  @@map("JefeOperaciones")
}

model Supervisor {
  id      String  @id
  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  tareasPorVerificar         Tarea[]
  definicionTareaPreventivas DefinicionTareaPreventiva[]
  visitas                    VisitaSupervisor[]

  @@map("Supervisor")
}

model Operario {
  id        String        @id
  usuario   Usuario       @relation(fields: [id], references: [id], onDelete: Cascade)
  funciones TipoFuncion[]
  tareas    Tarea[]       @relation("TareaOperarios")
  conjuntos Conjunto[]    @relation("OperarioConjuntos")

  cursoSalvamentoAcuatico   Boolean
  urlEvidenciaSalvamento    String?
  cursoAlturas              Boolean
  urlEvidenciaAlturas       String?
  examenIngreso             Boolean
  urlEvidenciaExamenIngreso String?

  fechaIngreso           DateTime
  fechaSalida            DateTime?
  fechaUltimasVacaciones DateTime?
  observaciones          String?

  consumos              ConsumoInsumo[]
  maquinariaAsignada    Maquinaria[]
  solicitudesMaquinaria SolicitudMaquinaria[]

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  definicionesPreventivas DefinicionTareaPreventiva[]     @relation("DefinicionOperarios")
  maquinariaConjuntos     MaquinariaConjunto[]
  usoMaquinarias          UsoMaquinaria[]
  usoHerramientas         UsoHerramienta[]
  disponibilidadPeriodos  OperarioDisponibilidadPeriodo[]

  // Necesidades operativas: la(s) plaza(s) de conjunto que ocupa actualmente.
  // En la práctica una sola (ver @@unique([conjuntoId, operarioId]) en
  // ConjuntoNecesidadOperario), pero se modela como lista para permitir
  // varios conjuntos sin restricción adicional aquí.
  necesidadesOcupadas ConjuntoNecesidadOperario[] @relation("NecesidadOperarioActual")

  // Asistencia / novedades
  registrosAsistencia        RegistroAsistencia[]
  turnosExtra                TurnoExtra[]         @relation("TurnoExtraOperario")
  turnosExtraComoReemplazado TurnoExtra[]         @relation("TurnoExtraReemplazado")

  @@map("Operario")
}

model OperarioDisponibilidadPeriodo {
  id Int @id @default(autoincrement())

  operario   Operario @relation(fields: [operarioId], references: [id], onDelete: Cascade)
  operarioId String

  fechaInicio DateTime
  fechaFin    DateTime?

  trabajaDomingo Boolean    @default(false)
  diaDescanso    DiaSemana?
  observaciones  String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([operarioId, fechaInicio, fechaFin])
  @@map("OperarioDisponibilidadPeriodo")
}

/**
 * =========================================
 * MODELOS - ASISTENCIA / NOVEDADES
 * =========================================
 */

/// Catalogo de conceptos de asistencia por empresa (A, F, V, PR, PNR, EG, AT, ...).
/// Editable por empresa en vez de enum fijo para poder ajustar codigos/colores
/// sin migracion, igual que TipoMaquinariaCatalogo/Herramienta.
model ConceptoAsistencia {
  id Int @id @default(autoincrement())

  empresa   Empresa @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  empresaId String

  codigo              String
  nombre              String
  cuentaComoTrabajado Boolean @default(false)
  colorHex            String  @default("#9E9E9E")
  activo              Boolean @default(true)
  orden               Int     @default(0)

  registros RegistroAsistencia[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, activo, orden])
  @@map("ConceptoAsistencia")
}

/// Una fila por operario+fecha: el equivalente a una celda del grid mensual
/// del Excel de asistencia. Se llena por check-in QR (concepto A/DFC/DFP) o
/// manualmente (permisos, faltas, vacaciones, incapacidades, etc).
model RegistroAsistencia {
  id Int @id @default(autoincrement())

  operario   Operario @relation(fields: [operarioId], references: [id], onDelete: Cascade)
  operarioId String

  conjunto   Conjunto? @relation(fields: [conjuntoId], references: [nit], onDelete: SetNull)
  conjuntoId String?

  fecha DateTime @db.Date

  concepto   ConceptoAsistencia @relation(fields: [conceptoId], references: [id])
  conceptoId Int

  horaEntrada DateTime?
  horaSalida  DateTime?

  latitudEntrada  Decimal? @db.Decimal(10, 7)
  longitudEntrada Decimal? @db.Decimal(10, 7)
  latitudSalida   Decimal? @db.Decimal(10, 7)
  longitudSalida  Decimal? @db.Decimal(10, 7)

  origen OrigenRegistroAsistencia @default(MANUAL)

  observacion String?

  registradoPorId  String?
  actualizadoPorId String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([operarioId, fecha])
  @@index([conjuntoId, fecha])
  @@index([operarioId, fecha])
  @@map("RegistroAsistencia")
}

/// Refleja la hoja "TURNOS" del Excel: turnos adicionales y reemplazos que no
/// caben en el grid diario (persona extra cubriendo a otra, novenas, etc).
/// Visita de un supervisor a un conjunto (entrada/salida por QR). A diferencia
/// de RegistroAsistencia (una fila por operario y día), un supervisor puede
/// visitar varios conjuntos y volver varias veces el mismo día.
model VisitaSupervisor {
  id Int @id @default(autoincrement())

  supervisor   Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  supervisorId String

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  fecha       DateTime  @db.Date
  horaEntrada DateTime
  horaSalida  DateTime?

  latitudEntrada  Decimal? @db.Decimal(10, 7)
  longitudEntrada Decimal? @db.Decimal(10, 7)
  latitudSalida   Decimal? @db.Decimal(10, 7)
  longitudSalida  Decimal? @db.Decimal(10, 7)
  distanciaEntradaMetros Int?
  distanciaSalidaMetros  Int?

  creadoEn DateTime @default(now())

  @@index([supervisorId, fecha])
  @@index([conjuntoId, fecha])
  @@map("VisitaSupervisor")
}

model TurnoExtra {
  id Int @id @default(autoincrement())

  empresa   Empresa @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  empresaId String

  operario   Operario @relation("TurnoExtraOperario", fields: [operarioId], references: [id], onDelete: Cascade)
  operarioId String

  conjunto   Conjunto? @relation(fields: [conjuntoId], references: [nit], onDelete: SetNull)
  conjuntoId String?

  fecha DateTime       @db.Date
  tipo  TipoTurnoExtra @default(TURNO)

  esReemplazo Boolean @default(false)

  operarioReemplazado    Operario? @relation("TurnoExtraReemplazado", fields: [operarioReemplazadoId], references: [id], onDelete: SetNull)
  operarioReemplazadoId  String?
  reemplazadoNombreLibre String?

  motivo            String?
  valorNegociado    Decimal?         @db.Decimal(14, 2)
  turnosOrdinarios  Int              @default(0)
  turnosDominicales Int              @default(0)
  estado            EstadoTurnoExtra @default(PENDIENTE)

  registradoPorId String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([empresaId, fecha])
  @@index([operarioId, fecha])
  @@index([conjuntoId, fecha])
  @@map("TurnoExtra")
}

/**
 * =========================================
 * MODELOS - CLIENTE / SITIO (CONJUNTO) / HORARIOS
 * =========================================
 */

model Conjunto {
  nit       String @id
  nombre    String
  direccion String
  correo    String

  administrador   Administrador? @relation(fields: [administradorId], references: [id])
  administradorId String?

  empresa   Empresa? @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  empresaId String?

  fechaInicioContrato       DateTime?
  fechaFinContrato          DateTime?
  activo                    Boolean        @default(true)
  tipoServicio              TipoServicio[]
  valorMensual              Decimal?       @db.Decimal(14, 2)
  consignasEspeciales       String[]       @default([])
  valorAgregado             String[]       @default([])
  mapaConjuntoNombreArchivo String?
  mapaConjuntoMimeType      String?
  mapaConjuntoBytes         Bytes?
  mapaConjuntoActualizadoEn DateTime?

  // Operación
  operarios   Operario[]  @relation("OperarioConjuntos")
  inventario  Inventario?
  ubicaciones Ubicacion[]
  cronograma  Tarea[]

  // Solicitudes
  solicitudesTareas     SolicitudTarea[]
  solicitudesInsumos    SolicitudInsumo[]
  solicitudesMaquinaria SolicitudMaquinaria[]

  // Config/agenda
  horarios                      ConjuntoHorario[]
  DefinicionTareaPreventiva     DefinicionTareaPreventiva[]
  configuracionesZonaCronograma ConfiguracionZonaCronograma[]

  // Necesidades operativas (plazas/cargos): ver ConjuntoNecesidadOperario.
  necesidades ConjuntoNecesidadOperario[]

  // Asistencia / novedades
  qrAsistenciaToken       String?              @unique
  qrAsistenciaActualizado DateTime?
  registrosAsistencia     RegistroAsistencia[]
  turnosExtra             TurnoExtra[]
  visitasSupervisor       VisitaSupervisor[]

  // Ubicación del conjunto para validar el QR de asistencia: si está
  // configurada, el check-in solo se permite dentro de
  // `radioAsistenciaMetros` metros. `ubicacionMapsUrl` es el enlace de Google
  // Maps que se pegó (latitud/longitud salen de ahí).
  ubicacionMapsUrl      String?
  latitud               Decimal?  @db.Decimal(10, 7)
  longitud              Decimal?  @db.Decimal(10, 7)
  radioAsistenciaMetros Int       @default(150)

  // Overrides / maquinaria
  limiteHorasSemanaOverride  Int?
  maquinariaConjuntos        MaquinariaConjunto[]
  maquinarias                Maquinaria[]
  herramientasItemsPropios   HerramientaItem[]             @relation("HerramientaItemPropietario")
  herramientasItemsPrestados HerramientaItemConjunto[]
  herramientasStock          ConjuntoHerramientaStock[]
  solicitudHerramientas      SolicitudHerramienta[]
  prestamosHerramientas      PrestamoHerramientaConjunto[]
  compromisos                CompromisoConjunto[]
  residentes                 Residente[]
  pedidos                    PedidoApp[]
  configPuntos               ConfigPuntosConjunto?
  movimientosPuntos          MovimientoPuntos[]

  // Plan Esperanza
  planEsperanzaConfig PlanEsperanzaConfig?
  planesEsperanza     PlanEsperanza[]

  @@index([empresaId])
}

model CompromisoConjunto {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  titulo     String
  completado Boolean @default(false)

  creadoPor   Usuario? @relation("CompromisoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  creadaEn      DateTime  @default(now())
  cerradaEn     DateTime?
  actualizadaEn DateTime  @updatedAt

  @@index([conjuntoId, completado])
  @@index([conjuntoId, creadaEn])
  @@map("CompromisoConjunto")
}

model ConjuntoHorario {
  id         Int      @id @default(autoincrement())
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  dia          DiaSemana
  horaApertura String
  horaCierre   String

  descansoInicio String?
  descansoFin    String?

  @@unique([conjuntoId, dia])
}

/// Necesidad operativa (plaza/cargo) del conjunto: p.ej. "Todero #1". Es
/// independiente de la persona que la ocupa. Si `horarioEspecial` es true,
/// sus `horarios` (mismo shape que ConjuntoHorario) SOBRESCRIBEN el horario
/// general del conjunto para ese operario, incluso si exceden su ventana o
/// cubren días en que el conjunto no opera. Si es false, la plaza hereda el
/// horario general del conjunto sin cambios (comportamiento actual).
/// `trabajaFestivos`/`descansoCompensatorio` son independientes de
/// `horarioEspecial`: cualquier plaza puede tener horario festivo propio y
/// descanso compensatorio, tenga o no días especiales configurados.
model ConjuntoNecesidadOperario {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  // Roles requeridos por la plaza. Casi siempre uno solo, pero admite
  // combinaciones (p.ej. "Todero-Salvavidas"): el operario asignado debe
  // tener TODOS los roles listados aquí (ver validarYPrepararOperario).
  roles    TipoFuncion[]
  etiqueta String
  orden    Int           @default(0)

  horarioEspecial Boolean                    @default(false)
  horarios        ConjuntoNecesidadHorario[]

  // Horario festivo de la plaza: independiente del rol (antes solo
  // SALVAVIDAS podía trabajar festivos, regla fija en código). Si
  // `trabajaFestivos` es true, la plaza SÍ recibe tareas en un festivo,
  // dentro de esta franja (obligatoria en ese caso). Si es false, un
  // festivo es día no laborable para esta plaza, sin importar el rol.
  trabajaFestivos      Boolean @default(false)
  festivoHoraApertura  String?
  festivoHoraCierre    String?
  festivoDescansoInicio String?
  festivoDescansoFin    String?

  // Descanso compensatorio: si está activo, trabajar un festivo o un
  // domingo (con horario efectivo ese día) genera automáticamente un día
  // de descanso `diasDescansoCompensatorio` días después (corrido al
  // siguiente día laborable de la plaza si cae en otro día no trabajable).
  // En false para las plazas existentes: su cronograma no cambia con esta
  // migración.
  descansoCompensatorio     Boolean @default(false)
  diasDescansoCompensatorio Int     @default(1)

  // Operario que ocupa ACTUALMENTE la plaza (0..1). Un operario solo puede
  // ocupar una plaza por conjunto (ver @@unique abajo); dejar la plaza
  // vacante (null) es un estado válido y soportado.
  operario   Operario? @relation("NecesidadOperarioActual", fields: [operarioId], references: [id], onDelete: SetNull)
  operarioId String?

  activo        Boolean  @default(true)
  observaciones String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  definiciones DefinicionTareaPreventiva[] @relation("DefinicionNecesidades")
  tareas       Tarea[]                     @relation("TareaNecesidades")

  @@unique([conjuntoId, etiqueta])
  @@unique([conjuntoId, operarioId])
  @@index([conjuntoId, activo])
  @@index([operarioId])
  @@map("ConjuntoNecesidadOperario")
}

/// Horario propio de una ConjuntoNecesidadOperario. Mismo shape que
/// ConjuntoHorario a propósito: permite reutilizar HorarioDTO y
/// workIntervalsFromHorario() sin cambios.
model ConjuntoNecesidadHorario {
  id Int @id @default(autoincrement())

  necesidad   ConjuntoNecesidadOperario @relation(fields: [necesidadId], references: [id], onDelete: Cascade)
  necesidadId Int

  dia          DiaSemana
  horaApertura String
  horaCierre   String

  descansoInicio String?
  descansoFin    String?

  @@unique([necesidadId, dia])
  @@map("ConjuntoNecesidadHorario")
}

