/**
 * =========================================
 * MODELOS - INSUMOS / INVENTARIO / CONSUMOS
 * =========================================
 */

model Insumo {
  id         Int             @id @default(autoincrement())
  nombre     String
  unidad     String
  categoria  CategoriaInsumo
  umbralBajo Int?

  // Trazabilidad de quien creo el insumo (solo se llena para personalizados,
  // conjuntoId != ""; el catalogo de empresa se carga por Woo/importacion y
  // no tiene un creador puntual). Sin relacion formal por el mismo motivo
  // que Maquinaria.creadoPorId: se resuelve el nombre en la capa de servicio.
  creadoPorId String?
  creadoEn    DateTime @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  // "" (default) = insumo del catalogo de empresa (compra/Woo).
  // nit de un conjunto = insumo personalizado, creado y visible solo para ese
  // conjunto (no aparece en el catalogo de empresa ni es comprable via Woo).
  // No es una relacion formal de Prisma porque "" no corresponde a ningun
  // Conjunto real; el conjunto (si aplica) se valida en la capa de servicio.
  conjuntoId String @default("")

  wooSku              String?
  wooProductId        Int?
  // Cuantas unidades de "unidad" trae CADA unidad comprada en la tienda Woo.
  // Ej: el insumo se mide en litros y la tienda vende una garrafa de 3L =>
  // wooFactorConversion = 3. Comprar 2 garrafas suma 6, no 2, al inventario.
  wooFactorConversion Decimal @default(1) @db.Decimal(12, 4)

  // Contenido medible de CADA "unidad" contada en inventario, para mostrar el
  // total real en stock sin cambiar como se cuenta. Ej: unidad = "tarro",
  // contenidoPorUnidad = 1.8, unidadContenido = "L" => 4 tarros = 7.2 L.
  // Ambos opcionales y van juntos: si no se conoce el contenido (ej. escobas,
  // que se cuentan por unidad simple) se dejan null y no se muestra total.
  contenidoPorUnidad Decimal? @db.Decimal(12, 4)
  unidadContenido    String?

  inventarios                InventarioInsumo[]
  consumos                   ConsumoInsumo[]
  consumosEmpresa            InsumoConsumoEmpresa[]
  solicitudInsumoItem        SolicitudInsumoItem[]
  definicionTareaPreventivas DefinicionTareaPreventiva[]
  tareas                     Tarea[]
  pedidoAppItems             PedidoAppItem[]

  @@unique([empresaId, conjuntoId, nombre, unidad])
  @@unique([empresaId, wooSku])
  @@unique([empresaId, wooProductId])
  @@index([empresaId, conjuntoId])
  @@map("Insumo")
}

model Herramienta {
  id        Int                  @id @default(autoincrement())
  nombre    String
  unidad    String               @default("UNIDAD")
  categoria CategoriaHerramienta @default(OTROS)

  modoControl  ModoControlHerramienta @default(PRESTAMO)
  vidaUtilDias Int?
  umbralBajo   Int?

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  nombreNormalizado String?
  activo            Boolean                @default(true)
  estadoAprobacion  EstadoAprobacionActivo @default(APROBADA)
  creadoPorId       String?
  creadoEn          DateTime               @default(now())
  aprobadoPorId     String?
  aprobadoEn        DateTime?
  rechazadoPorId    String?
  rechazadoEn       DateTime?
  motivoRechazo     String?
  actualizadoPorId  String?
  actualizadoEn     DateTime               @default(now()) @updatedAt

  canonicaId Int?
  canonica   Herramienta?  @relation("HerramientaCanonica", fields: [canonicaId], references: [id], onDelete: SetNull)
  aliases    Herramienta[] @relation("HerramientaCanonica")

  stocksEmpresa  EmpresaHerramientaStock[]
  stocksConjunto ConjuntoHerramientaStock[]
  prestamos      PrestamoHerramientaConjunto[]
  usosTarea      UsoHerramienta[]
  solicitudItems SolicitudHerramientaItem[]
  itemsFisicos   HerramientaItem[]

  @@unique([empresaId, nombre, unidad])
  @@index([empresaId, nombreNormalizado])
  @@index([empresaId, activo, estadoAprobacion])
  @@map("Herramienta")
}

model HerramientaItem {
  id            Int     @id @default(autoincrement())
  codigoInterno String
  alias         String?
  marca         String?
  modelo        String?
  serial        String?

  empresa   Empresa @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  empresaId String

  herramienta   Herramienta @relation(fields: [herramientaId], references: [id])
  herramientaId Int

  propietarioTipo       PropietarioMaquinaria
  conjuntoPropietario   Conjunto?             @relation("HerramientaItemPropietario", fields: [conjuntoPropietarioId], references: [nit])
  conjuntoPropietarioId String?

  estado           EstadoHerramienta      @default(OPERATIVA)
  condicion        CondicionActivo?
  estadoAprobacion EstadoAprobacionActivo @default(PENDIENTE)
  registroLoteId   String?

  creadoPorId      String?
  creadoEn         DateTime  @default(now())
  aprobadoPorId    String?
  aprobadoEn       DateTime?
  rechazadoPorId   String?
  rechazadoEn      DateTime?
  motivoRechazo    String?
  actualizadoPorId String?
  actualizadoEn    DateTime  @default(now()) @updatedAt
  retiradoPorId    String?
  retiradoEn       DateTime?

  fotoDriveId       String?
  fotoNombre        String?
  fotoMimeType      String?
  fotoTamano        Int?
  fotoActualizadaEn DateTime?

  asignaciones HerramientaItemConjunto[]
