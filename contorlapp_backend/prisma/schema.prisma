  @@index([conjuntoId, periodoAnio, periodoMes, estado], map: "PEB_periodo_estado_idx")
  @@index([ocurrenciaPlanId], map: "PEB_ocurrenciaPlanId_idx")
  @@map("PreventivaExcluidaBorrador")
}

/// Inventario persistente de las ocurrencias que una definición debía generar.
/// Es la fuente del informe incluso cuando no existe ninguna Tarea programada.
model PreventivaOcurrenciaPlan {
  id String @id

  conjuntoId  String
  periodoAnio Int
  periodoMes  Int
  borrador    Boolean @default(true)

  defId                     Int?
  descripcion               String
