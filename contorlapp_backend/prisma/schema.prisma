model ConsumoInsumo {
  id           Int        @id @default(autoincrement())
  inventario   Inventario @relation(fields: [inventarioId], references: [id])
  inventarioId Int

  insumo   Insumo               @relation(fields: [insumoId], references: [id])
  insumoId Int
  tipo     TipoMovimientoInsumo @default(SALIDA)

  operario   Operario? @relation(fields: [operarioId], references: [id])
  operarioId String?

  // Quien registro el movimiento cuando quien actua NO es un operario (ej.
  // administrador/gerente/supervisor/jefe_operaciones haciendo un ingreso o
  // salida manual, o recibiendo una compra). Sin relacion FK, igual que
  // Insumo.creadoPorId, porque puede apuntar a un Usuario de cualquier rol.
  registradoPorId String?

  tarea   Tarea? @relation(fields: [tareaId], references: [id])
  tareaId Int?

  pedidoApp   PedidoApp? @relation("PedidoInventarioEntradas", fields: [pedidoAppId], references: [id], onDelete: SetNull)
  pedidoAppId Int?

  cantidad    Decimal  @db.Decimal(14, 4)
  fecha       DateTime
  observacion String?

  @@unique([pedidoAppId, insumoId, tipo])
  @@index([pedidoAppId])
  @@map("ConsumoInsumo")
}

model InsumoConsumoEmpresa {
