  operariosEsperadosIds     String[]    @default([])
  operariosEsperadosNombres String[]    @default([])

  estado          String    @default("PENDIENTE")
  motivoCodigo    String?
  motivoMensaje   String?
  fechaRealInicio DateTime?
  fechaRealFin    DateTime?

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@index([conjuntoId, periodoAnio, periodoMes, borrador], map: "POP_periodo_idx")
  @@index([defId], map: "POP_defId_idx")
  @@index([fechaObjetivo], map: "POP_fechaObjetivo_idx")
  @@map("PreventivaOcurrenciaPlan")
}

model PreventivaBorradorEvento {
  id Int @id @default(autoincrement())

  conjuntoId  String
  periodoAnio Int
  periodoMes  Int

  tareaId      Int?
  excluidaId   Int?
  tipo         String
  detalle      String?
  metadataJson Json?

