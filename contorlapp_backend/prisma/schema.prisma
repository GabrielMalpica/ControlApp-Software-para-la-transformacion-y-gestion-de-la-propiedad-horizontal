  @@unique([empresaId, codigoInterno])
  @@index([empresaId, herramientaId, estadoAprobacion, estado])
  @@index([conjuntoPropietarioId, estadoAprobacion, estado])
  @@index([registroLoteId])
  @@map("HerramientaItem")
