/**
 * =========================================
 * GENERATORS & DATASOURCE
 * =========================================
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================================
 * ENUMS - IDENTIDAD / RRHH
 * =========================================
 */

enum Rol {
  gerente
  administrador
  jefe_operaciones
  supervisor
  operario
  residente
}

enum TipoUnidadResidencial {
  APARTAMENTO
  CASA
  OFICINA
  LOCAL
}

enum TipoPedidoApp {
  CONJUNTO
  RESIDENTE
}

enum EstadoPedidoInterno {
  BORRADOR
  PENDIENTE_PAGO
  PAGADO
  PENDIENTE_ENVIO
  ENVIADO
  RECIBIDO
  ENTREGADO
  CANCELADO
}

enum TipoMovimientoPuntos {
  ACUMULACION
  REDENCION
  AJUSTE
}

enum EstadoCivil {
  SOLTERO
  CASADO
  UNION_LIBRE
  VIUDOA
}

enum TipoSangre {
  O_POSITIVO
  O_NEGATIVO
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
}

enum EPS {
  SANITAS
  NUEVA_EPS
  SALUD_TOTAL
  SURA
  COMPENSAR
  FAMISANAR
  COOSALUD
  MUTUAL_SER
  SAVIA_SALUD
  CAPITAL_SALUD
  ASMET_SALUD
  ECOOPSOS
  EMSSANAR
  CAJACOPI
  COMFENALCO_ANTIOQUIA
  COMFACHOCO
  COMPARTA
  DUSAKAWI
  MALLAMAS
  ANAS_WAIMAS
}

enum FondoPension {
  COLPENSIONES
  PORVENIR
  PROTECCION
  COLFONDOS
  SKANDIA
  OLD_MUTUAL
}

enum TipoContrato {
  TERMINO_INDEFINIDO
  TERMINO_FIJO
  OBRA_LABOR
}

enum JornadaLaboral {
  COMPLETA
  MEDIO_TIEMPO
  FINES_DE_SEMANA
}

enum PatronJornada {
  MEDIO_SEMANA_SABADO
  MEDIO_SEMANA_SABADO_TARDE
  MEDIO_DIAS_INTERCALADOS
}

enum TallaCamisa {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum TallaPantalon {
  T_28
  T_30
  T_32
  T_34
  T_36
  T_38
  T_40
  T_42
  F_6
  F_8
  F_10
  F_12
  F_14
  F_16
}

enum TallaCalzado {
  T_34
  T_35
  T_36
  T_37
  T_38
  T_39
  T_40
  T_41
  T_42
  T_43
  T_44
}

enum TipoFuncion {
  TODERO
  SALVAVIDAS
  ASEO
}

/**
 * =========================================
 * ENUMS - OPERACIÓN / SERVICIOS / AGENDA
 * =========================================
 */

enum TipoServicio {
  JARDINERIA
  PISCINA
  ASEO
  MANTENIMIENTOS_LOCATIVOS
  SALVAMENTO_ACUATICO
}

enum Frecuencia {
  DIARIA
  SEMANAL
  QUINCENAL
  MENSUAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TipoTarea {
  PREVENTIVA
  CORRECTIVA
}

enum EstadoTarea {
  ASIGNADA
  EN_PROCESO
  COMPLETADA
  APROBADA
  PENDIENTE_APROBACION
  RECHAZADA
  NO_COMPLETADA
  PENDIENTE_REPROGRAMACION
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/**
 * =========================================
 * ENUMS - INSUMOS / INVENTARIO
 * =========================================
 */

enum CategoriaInsumo {
  LIMPIEZA
  JARDINERIA
  PISCINA
  FERRETERIA
  OTROS
}

enum CategoriaHerramienta {
  LIMPIEZA
  JARDINERIA
  PISCINA
  OTROS
}

enum UnidadCalculo {
  M
  UNIDAD
  M2
  M3
  ML
  LITRO
  KILO
  HORA
}

enum TipoMovimientoInsumo {
  ENTRADA
  SALIDA
  AJUSTE
}

enum EstadoUsoHerramienta {
  RESERVADA
  EN_USO
  DEVUELTA
  CONSUMIDA
  CANCELADA
}

enum OrigenHerramientaStock {
  EMPRESA
  CONJUNTO
}

/**
 * =========================================
 * ENUMS - MAQUINARIA
 * =========================================
 */

enum TipoMaquinaria {
  CORTASETOS_MANO
  CORTASETOS_ALTURA
  GUADANIA
  PODADORA_CESPED
  ESCALERA
  SOPLADORA
  FUMIGADORA_MOTOR
  BOMBA_ESPALDA
  MOTOSIERRA_MANO
  MOTOSIERRA_ALTURA
  HIDROLAVADORA_ELECTRICA
  HIDROLAVADORA_GASOLINA
  PULIDORA
  TALADRO
  ROTOMARTILLO
  LAVABRILLADORA
  COMPRESOR
  PULVERIZADORA_PINTURA
  EQUIPO_ALTURAS
  MEDIA_LUNA
  CAJA_HERRAMIENTAS
  OTRO
}

enum EstadoMaquinaria {
  OPERATIVA
  EN_REPARACION
  FUERA_DE_SERVICIO
}

enum PropietarioMaquinaria {
  EMPRESA
  CONJUNTO
}

enum TipoTenenciaMaquinaria {
  PROPIA
  PRESTADA
}

enum EstadoAsignacionMaquinaria {
  RESERVADA
  ACTIVA
  DEVUELTA
  INACTIVA
}

enum EstadoSolicitudMaquinaria {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
  DEVUELTA
}

enum ModoControlHerramienta {
  PRESTAMO
  CONSUMO
  VIDA_CORTA
}

enum EstadoHerramienta {
  OPERATIVA
  DANADA
  PERDIDA
  BAJA
}

/**
 * =========================================
 * ENUMS - RENDIMIENTOS
 * =========================================
 */

enum RendimientoBaseTiempo {
  POR_HORA
  POR_MINUTO
  MIN_POR_UNIDAD
}

/**
 * =========================================
 * MODELOS - CONFIG / MAESTROS
 * =========================================
 */

model ConfiguracionSistema {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String
}

model ConfiguracionLaboral {
  id                    Int      @id @default(1)
  horasSemanalesLegales Int // 44 hoy, 42 mañana
  updatedAt             DateTime @updatedAt

  @@map("ConfiguracionLaboral")
}

/**
 * =========================================
 * MODELOS - NÚCLEO EMPRESA / USUARIOS / ROLES
 * =========================================
 */

model Usuario {
  id         String  @id
  nombre     String
  correo     String  @unique
  contrasena String
  rol                      String
  activo                   Boolean @default(true)
  requiereCambioContrasena Boolean @default(false)

  telefono        BigInt
  fechaNacimiento DateTime
  direccion       String?
  estadoCivil     EstadoCivil?
  numeroHijos     Int?
  padresVivos     Boolean?
  tipoSangre      TipoSangre?
  eps             EPS?
  fondoPensiones  FondoPension?
  tallaCamisa     TallaCamisa?
  tallaPantalon   TallaPantalon?
  tallaCalzado    TallaCalzado?
  tipoContrato    TipoContrato?

  jornadaLaboral JornadaLaboral?
  patronJornada  PatronJornada?

  gerente            Gerente?
  jefeOperaciones    JefeOperaciones?
  supervisor         Supervisor?
  operario           Operario?
  administrador      Administrador?
  residente          Residente?
  compromisosCreados CompromisoConjunto[] @relation("CompromisoCreadoPor")
  pedidos            PedidoApp[]
  movimientosPuntos  MovimientoPuntos[]
  cambiosEstadoPedido PedidoAppEstadoHistorico[] @relation("PedidoEstadoCambiadoPor")
}

model Empresa {
  id                Int    @id @default(autoincrement())
  nombre            String
  nit               String @unique
  limiteHorasSemana Int    @default(42)

  // Roles
  gerentes         Gerente[]
  jefesOperaciones JefeOperaciones[]
  supervisores     Supervisor[]
  operarios        Operario[]

  // Clientes/Conjuntos
  conjuntos Conjunto[]

  // Catálogos/Stock
  stockMaquinaria Maquinaria[]
  catalogoInsumos Insumo[]

  // Solicitudes
  solicitudesTareas     SolicitudTarea[]
  solicitudesInsumos    SolicitudInsumo[]
  solicitudesMaquinaria SolicitudMaquinaria[]

  // Flujo de aprobación/rechazo
  tareasAprobadas  Tarea[] @relation("EmpresaTareasAprobadas")
  tareasRechazadas Tarea[] @relation("EmpresaTareasRechazadas")

  // Analítica/consumos
  insumosConsumidos       InsumoConsumoEmpresa[]
  Rendimiento             Rendimiento[]
  catalogoHerramientas    Herramienta[]
  stockHerramientas       EmpresaHerramientaStock[]
  solicitudesHerramientas SolicitudHerramienta[]
  prestamosHerramientas   PrestamoHerramientaConjunto[]
  permisosRol             PermisoRol[]

  @@map("Empresa")
}

model PermisoRol {
  id        Int      @id @default(autoincrement())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  rol       Rol
  permiso   String
  permitido Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, rol, permiso])
  @@index([empresaId, rol])
  @@map("PermisoRol")
}

model Gerente {
  id        String   @id
  usuario   Usuario  @relation(fields: [id], references: [id], onDelete: Cascade)
  empresa   Empresa? @relation(fields: [empresaId], references: [nit])
  empresaId String?

  @@map("Gerente")
}

model Administrador {
  id        String     @id
  usuario   Usuario    @relation(fields: [id], references: [id], onDelete: Cascade)
  conjuntos Conjunto[]

  @@map("Administrador")
}

model JefeOperaciones {
  id      String  @id
  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  @@map("JefeOperaciones")
}

model Supervisor {
  id      String  @id
  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  tareasPorVerificar         Tarea[]
  definicionTareaPreventivas DefinicionTareaPreventiva[]

  @@map("Supervisor")
}

model Operario {
  id        String        @id
  usuario   Usuario       @relation(fields: [id], references: [id], onDelete: Cascade)
  funciones TipoFuncion[]
  tareas    Tarea[]       @relation("TareaOperarios")
  conjuntos Conjunto[]    @relation("OperarioConjuntos")

  cursoSalvamentoAcuatico   Boolean
  urlEvidenciaSalvamento    String?
  cursoAlturas              Boolean
  urlEvidenciaAlturas       String?
  examenIngreso             Boolean
  urlEvidenciaExamenIngreso String?

  fechaIngreso           DateTime
  fechaSalida            DateTime?
  fechaUltimasVacaciones DateTime?
  observaciones          String?

  consumos              ConsumoInsumo[]
  maquinariaAsignada    Maquinaria[]
  solicitudesMaquinaria SolicitudMaquinaria[]

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  definicionesPreventivas DefinicionTareaPreventiva[]     @relation("DefinicionOperarios")
  maquinariaConjuntos     MaquinariaConjunto[]
  usoMaquinarias          UsoMaquinaria[]
  usoHerramientas         UsoHerramienta[]
  disponibilidadPeriodos  OperarioDisponibilidadPeriodo[]

  @@map("Operario")
}

model OperarioDisponibilidadPeriodo {
  id Int @id @default(autoincrement())

  operario   Operario @relation(fields: [operarioId], references: [id], onDelete: Cascade)
  operarioId String

  fechaInicio DateTime
  fechaFin    DateTime?

  trabajaDomingo Boolean    @default(false)
  diaDescanso    DiaSemana?
  observaciones  String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([operarioId, fechaInicio, fechaFin])
  @@map("OperarioDisponibilidadPeriodo")
}

/**
 * =========================================
 * MODELOS - CLIENTE / SITIO (CONJUNTO) / HORARIOS
 * =========================================
 */

model Conjunto {
  nit       String @id
  nombre    String
  direccion String
  correo    String

  administrador   Administrador? @relation(fields: [administradorId], references: [id])
  administradorId String?

  empresa   Empresa? @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  empresaId String?

  fechaInicioContrato       DateTime?
  fechaFinContrato          DateTime?
  activo                    Boolean        @default(true)
  tipoServicio              TipoServicio[]
  valorMensual              Decimal?       @db.Decimal(14, 2)
  consignasEspeciales       String[]       @default([])
  valorAgregado             String[]       @default([])
  mapaConjuntoNombreArchivo String?
  mapaConjuntoMimeType      String?
  mapaConjuntoBytes         Bytes?
  mapaConjuntoActualizadoEn DateTime?

  // Operación
  operarios   Operario[]  @relation("OperarioConjuntos")
  inventario  Inventario?
  ubicaciones Ubicacion[]
  cronograma  Tarea[]

  // Solicitudes
  solicitudesTareas     SolicitudTarea[]
  solicitudesInsumos    SolicitudInsumo[]
  solicitudesMaquinaria SolicitudMaquinaria[]

  // Config/agenda
  horarios                  ConjuntoHorario[]
  DefinicionTareaPreventiva DefinicionTareaPreventiva[]
  configuracionesZonaCronograma ConfiguracionZonaCronograma[]

  // Overrides / maquinaria
  limiteHorasSemanaOverride Int?
  maquinariaConjuntos       MaquinariaConjunto[]
  maquinarias               Maquinaria[]
  herramientasStock         ConjuntoHerramientaStock[]
  solicitudHerramientas     SolicitudHerramienta[]
  prestamosHerramientas     PrestamoHerramientaConjunto[]
  compromisos               CompromisoConjunto[]
  residentes                Residente[]
  pedidos                   PedidoApp[]
  configPuntos              ConfigPuntosConjunto?
  movimientosPuntos         MovimientoPuntos[]

  // Plan Esperanza
  planEsperanzaConfig PlanEsperanzaConfig?
  planesEsperanza     PlanEsperanza[]

  @@index([empresaId])
}

model CompromisoConjunto {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  titulo     String
  completado Boolean @default(false)

  creadoPor   Usuario? @relation("CompromisoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  creadaEn      DateTime @default(now())
  cerradaEn     DateTime?
  actualizadaEn DateTime @updatedAt

  @@index([conjuntoId, completado])
  @@index([conjuntoId, creadaEn])
  @@map("CompromisoConjunto")
}

model ConjuntoHorario {
  id         Int      @id @default(autoincrement())
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  dia          DiaSemana
  horaApertura String
  horaCierre   String

  descansoInicio String?
  descansoFin    String?

  @@unique([conjuntoId, dia])
}

/**
 * =========================================
 * MODELOS - UBICACIÓN / ELEMENTOS
 * =========================================
 */

model Ubicacion {
  id     Int    @id @default(autoincrement())
  nombre String

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  elementos                 Elemento[]
  tareas                    Tarea[]
  solicitudesTareas         SolicitudTarea[]
  DefinicionTareaPreventiva DefinicionTareaPreventiva[]

  @@index([conjuntoId])
  @@map("Ubicacion")
}

model Elemento {
  id     Int    @id @default(autoincrement())
  nombre String

  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id], onDelete: Cascade)
  ubicacionId Int

  padre   Elemento?  @relation("ElementoJerarquia", fields: [padreId], references: [id], onDelete: Cascade)
  padreId Int?
  hijos   Elemento[] @relation("ElementoJerarquia")

  tareas                    Tarea[]
  solicitudesTareas         SolicitudTarea[]
  DefinicionTareaPreventiva DefinicionTareaPreventiva[]
  diagnosticosPlanEsperanza DiagnosticoArea[]
  configuracionCronograma   ConfiguracionZonaCronograma?

  @@index([ubicacionId, padreId])
  @@map("Elemento")
}

/// Preferencias de orden y color para una zona raiz dentro del cronograma.
/// Se mantiene separada de Elemento para no reescribir la jerarquia existente.
model ConfiguracionZonaCronograma {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  elementoZona   Elemento @relation(fields: [elementoZonaId], references: [id], onDelete: Cascade)
  elementoZonaId Int      @unique

  orden    Int
  colorHex String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([conjuntoId, orden])
  @@map("ConfiguracionZonaCronograma")
}

/**
 * =========================================
 * MODELOS - INSUMOS / INVENTARIO / CONSUMOS
 * =========================================
 */

model Insumo {
  id         Int             @id @default(autoincrement())
  nombre     String
  unidad     String
  categoria  CategoriaInsumo
  umbralBajo Int?

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  wooSku       String?
  wooProductId Int?

  inventarios                InventarioInsumo[]
  consumos                   ConsumoInsumo[]
  consumosEmpresa            InsumoConsumoEmpresa[]
  solicitudInsumoItem        SolicitudInsumoItem[]
  definicionTareaPreventivas DefinicionTareaPreventiva[]
  tareas                     Tarea[]
  pedidoAppItems             PedidoAppItem[]

  @@unique([empresaId, nombre, unidad])
  @@unique([empresaId, wooSku])
  @@unique([empresaId, wooProductId])
  @@map("Insumo")
}

model Herramienta {
  id        Int                  @id @default(autoincrement())
  nombre    String
  unidad    String               @default("UNIDAD")
  categoria CategoriaHerramienta @default(OTROS)

  modoControl  ModoControlHerramienta @default(PRESTAMO)
  vidaUtilDias Int?
  umbralBajo   Int?

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  stocksEmpresa  EmpresaHerramientaStock[]
  stocksConjunto ConjuntoHerramientaStock[]
  prestamos      PrestamoHerramientaConjunto[]
  usosTarea      UsoHerramienta[]
  solicitudItems SolicitudHerramientaItem[]

  @@unique([empresaId, nombre, unidad])
  @@map("Herramienta")
}

model EmpresaHerramientaStock {
  id Int @id @default(autoincrement())

  empresa   Empresa @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  empresaId String

  herramienta   Herramienta @relation(fields: [herramientaId], references: [id], onDelete: Cascade)
  herramientaId Int

  cantidad Decimal           @db.Decimal(14, 4)
  estado   EstadoHerramienta @default(OPERATIVA)

  actualizadoEn DateTime @updatedAt

  @@unique([empresaId, herramientaId, estado])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@map("EmpresaHerramientaStock")
}

model ConjuntoHerramientaStock {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  herramienta   Herramienta @relation(fields: [herramientaId], references: [id])
  herramientaId Int

  cantidad Decimal           @db.Decimal(14, 4)
  estado   EstadoHerramienta @default(OPERATIVA)

  actualizadoEn DateTime @updatedAt

  @@unique([conjuntoId, herramientaId, estado])
  @@index([conjuntoId, estado])
  @@map("ConjuntoHerramientaStock")
}

model PrestamoHerramientaConjunto {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  empresa   Empresa @relation(fields: [empresaId], references: [nit], onDelete: Cascade)
  empresaId String

  herramienta   Herramienta @relation(fields: [herramientaId], references: [id], onDelete: Cascade)
  herramientaId Int

  solicitud   SolicitudHerramienta? @relation(fields: [solicitudId], references: [id], onDelete: SetNull)
  solicitudId Int?

  cantidad Decimal           @db.Decimal(14, 4)
  estado   EstadoHerramienta @default(OPERATIVA)

  fechaInicio             DateTime  @default(now())
  fechaFin                DateTime?
  fechaDevolucionEstimada DateTime?
  actualizadoEn           DateTime  @updatedAt

  @@index([conjuntoId, estado])
  @@index([conjuntoId, fechaFin])
  @@index([herramientaId, fechaFin])
  @@index([empresaId, fechaFin])
  @@map("PrestamoHerramientaConjunto")
}

model UsoHerramienta {
  id Int @id @default(autoincrement())

  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  tareaId Int

  herramienta   Herramienta @relation(fields: [herramientaId], references: [id])
  herramientaId Int

  cantidad Decimal @default(1) @db.Decimal(14, 4)

  origenStock OrigenHerramientaStock @default(CONJUNTO)

  estado EstadoUsoHerramienta @default(RESERVADA)

  operario   Operario? @relation(fields: [operarioId], references: [id])
  operarioId String?

  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  observacion String?

  @@index([tareaId])
  @@index([herramientaId])
  @@map("UsoHerramienta")
}

model SolicitudHerramienta {
  id              Int       @id @default(autoincrement())
  fechaSolicitud  DateTime  @default(now())
  fechaAprobacion DateTime?

  estado               EstadoSolicitud @default(PENDIENTE)
  observacionRespuesta String?

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit])
  conjuntoId String

  empresa   Empresa? @relation(fields: [empresaId], references: [nit])
  empresaId String?

  items     SolicitudHerramientaItem[]
  prestamos PrestamoHerramientaConjunto[]

  @@index([conjuntoId, estado])
  @@map("SolicitudHerramienta")
}

model SolicitudHerramientaItem {
  id Int @id @default(autoincrement())

  solicitud   SolicitudHerramienta @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  solicitudId Int

  herramienta   Herramienta @relation(fields: [herramientaId], references: [id])
  herramientaId Int

  cantidad Decimal @db.Decimal(14, 4)

  @@unique([solicitudId, herramientaId])
  @@map("SolicitudHerramientaItem")
}

model Inventario {
  id         Int      @id @default(autoincrement())
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit])
  conjuntoId String   @unique

  insumos  InventarioInsumo[]
  consumos ConsumoInsumo[]

  @@map("Inventario")
}

model InventarioInsumo {
  id           Int        @id @default(autoincrement())
  inventario   Inventario @relation(fields: [inventarioId], references: [id])
  inventarioId Int

  insumo   Insumo @relation(fields: [insumoId], references: [id])
  insumoId Int

  cantidad     Decimal @db.Decimal(14, 4)
  umbralMinimo Int?

  @@unique([inventarioId, insumoId])
  @@index([inventarioId, cantidad])
}

model ConsumoInsumo {
  id           Int        @id @default(autoincrement())
  inventario   Inventario @relation(fields: [inventarioId], references: [id])
  inventarioId Int

  insumo   Insumo               @relation(fields: [insumoId], references: [id])
  insumoId Int
  tipo     TipoMovimientoInsumo @default(SALIDA)

  operario   Operario? @relation(fields: [operarioId], references: [id])
  operarioId String?

  tarea   Tarea? @relation(fields: [tareaId], references: [id])
  tareaId Int?

  pedidoApp   PedidoApp? @relation("PedidoInventarioEntradas", fields: [pedidoAppId], references: [id], onDelete: SetNull)
  pedidoAppId Int?

  cantidad    Decimal  @db.Decimal(14, 4)
  fecha       DateTime
  observacion String?

  @@unique([pedidoAppId, insumoId, tipo])
  @@index([pedidoAppId])
  @@map("ConsumoInsumo")
}

model InsumoConsumoEmpresa {
  id       Int    @id @default(autoincrement())
  insumo   Insumo @relation(fields: [insumoId], references: [id])
  insumoId Int

  empresa   Empresa @relation(fields: [empresaId], references: [nit])
  empresaId String

  cantidad Int
  fecha    DateTime
}

/**
 * =========================================
 * MODELOS - MAQUINARIA / ASIGNACIONES / USO
 * =========================================
 */

model Maquinaria {
  id     Int              @id @default(autoincrement())
  nombre String
  marca  String
  tipo   TipoMaquinaria
  estado EstadoMaquinaria @default(OPERATIVA)

  propietarioTipo       PropietarioMaquinaria
  empresa               Empresa?              @relation(fields: [empresaId], references: [nit])
  empresaId             String?
  conjuntoPropietario   Conjunto?             @relation(fields: [conjuntoPropietarioId], references: [nit])
  conjuntoPropietarioId String?

  asignaciones         MaquinariaConjunto[]
  operario             Operario?             @relation(fields: [operarioId], references: [id])
  operarioId           String?
  solicitudMaquinarias SolicitudMaquinaria[]
  usoMaquinarias       UsoMaquinaria[]

  @@map("Maquinaria")
}

model MaquinariaConjunto {
  id         Int      @id @default(autoincrement())
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit])
  conjuntoId String

  maquinaria   Maquinaria @relation(fields: [maquinariaId], references: [id])
  maquinariaId Int

  tipoTenencia TipoTenenciaMaquinaria
  estado       EstadoAsignacionMaquinaria @default(ACTIVA)

  fechaInicio             DateTime  @default(now())
  fechaFin                DateTime?
  fechaDevolucionEstimada DateTime?

  responsable Operario? @relation(fields: [operarioId], references: [id])
  operarioId  String?

  solicitudMaquinaria SolicitudMaquinaria?

  tareaId Int?
  tarea   Tarea? @relation(fields: [tareaId], references: [id], onDelete: SetNull)

  @@unique([conjuntoId, maquinariaId, estado])
  @@index([conjuntoId, estado])
  @@index([maquinariaId, estado])
  @@index([tareaId])
}

model UsoMaquinaria {
  id Int @id @default(autoincrement())

  tarea   Tarea @relation(fields: [tareaId], references: [id])
  tareaId Int

  maquinaria   Maquinaria @relation(fields: [maquinariaId], references: [id])
  maquinariaId Int

  operario   Operario? @relation(fields: [operarioId], references: [id])
  operarioId String?

  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  observacion String?

  @@index([tareaId])
  @@index([maquinariaId])
}

/**
 * =========================================
 * MODELOS - TAREAS / DEFINICIONES PREVENTIVAS
 * =========================================
 */

model DefinicionTareaPreventiva {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id])
  ubicacionId Int
  elemento    Elemento  @relation(fields: [elementoId], references: [id])
  elementoId  Int

  descripcion           String
  frecuencia            Frecuencia
  prioridad             Int        @default(2)
  diaSemanaProgramado   DiaSemana?
  diaMesProgramado      Int?
  fechasProgramadasJson Json?

  // Duración planificada
  unidadCalculo         UnidadCalculo?
  areaNumerica          Decimal?               @db.Decimal(14, 4)
  rendimientoBase       Decimal?
  rendimientoTiempoBase RendimientoBaseTiempo? @default(POR_HORA)
  duracionMinutosFija   Int?
  diasParaCompletar     Int?

  // Recursos planeados
  insumoPrincipalId         Int?
  insumoPrincipal           Insumo?  @relation(fields: [insumoPrincipalId], references: [id])
  consumoPrincipalPorUnidad Decimal? @db.Decimal(14, 4)
  insumosPlanJson           Json?
  maquinariaPlanJson        Json?
  herramientasPlanJson      Json?

  // Operarios sugeridos (M:N)
  operarios Operario[] @relation("DefinicionOperarios")

  // Supervisor responsable
  supervisorId String?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id])

  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  rendimientoId Int?
  rendimiento   Rendimiento? @relation(fields: [rendimientoId], references: [id])

  cuadrillaSugerida     Int?
  factoresSugeridosJson Json?

  insumosSiteOverrideJson Json?

  @@index([conjuntoId, activo])
  @@map("DefinicionTareaPreventiva")
}

model Tarea {
  id                  Int         @id @default(autoincrement())
  descripcion         String
  fechaInicio         DateTime
  fechaFin            DateTime
  fechaIniciarTarea   DateTime?
  fechaFinalizarTarea DateTime?
  duracionMinutos     Int
  prioridad           Int         @default(2)
  estado              EstadoTarea @default(ASIGNADA)

  evidencias           String[]  @default([])
  insumosUsados        Json?
  observaciones        String?
  observacionesRechazo String?
  fechaVerificacion    DateTime?
  finalizadaPorId      String?
  finalizadaPorRol     String?

  operarios    Operario[]  @relation("TareaOperarios")
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id])
  supervisorId String?

  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id])
  ubicacionId Int
  elemento    Elemento  @relation(fields: [elementoId], references: [id])
  elementoId  Int

  conjunto   Conjunto? @relation(fields: [conjuntoId], references: [nit])
  conjuntoId String?

  empresaAprobadaId  Int?
  empresaAprobada    Empresa? @relation("EmpresaTareasAprobadas", fields: [empresaAprobadaId], references: [id])
  empresaRechazadaId Int?
  empresaRechazada   Empresa? @relation("EmpresaTareasRechazadas", fields: [empresaRechazadaId], references: [id])

  tipo       TipoTarea   @default(CORRECTIVA)
  frecuencia Frecuencia?

  // Origen preventivo (trazabilidad hacia la definición que la generó)
  definicionId        Int?
  diaSemanaProgramado DiaSemana?

  // Planificación / cronograma
  borrador       Boolean @default(false)
  periodoAnio    Int?
  periodoMes     Int?
  grupoPlanId    String?
  bloqueIndex    Int?
  bloquesTotales Int?
  ocurrenciaPlanId String?

  // Rendimientos / estimaciones
  tiempoEstimadoMinutos     Int?
  insumoPrincipalId         Int?
  insumoPrincipal           Insumo?  @relation(fields: [insumoPrincipalId], references: [id])
  consumoPrincipalPorUnidad Decimal? @db.Decimal(14, 4)
  consumoTotalEstimado      Decimal? @db.Decimal(14, 4)
  insumosPlanJson           Json?
  maquinariaPlanJson        Json?

  ConsumoInsumo        ConsumoInsumo[]
  rendimientoId        Int?
  rendimiento          Rendimiento?         @relation(fields: [rendimientoId], references: [id])
  rendimientoVersion   Int?
  rendimientoAplicado  RendimientoAplicado?
  usoMaquinarias       UsoMaquinaria[]
  usoHerramientas      UsoHerramienta[]
  herramientasPlanJson Json?
  maquinariaConjuntos  MaquinariaConjunto[]

  reprogramada           Boolean   @default(false)
  reprogramadaEn         DateTime?
  reprogramadaMotivo     String?
  reprogramadaPorTareaId Int?
  fechaInicioOriginal    DateTime?
  fechaFinOriginal       DateTime?

  @@index([conjuntoId, fechaInicio])
  @@index([conjuntoId, fechaFin])
  @@index([periodoAnio, periodoMes, conjuntoId])
  @@index([conjuntoId, periodoAnio, periodoMes, borrador])
  @@index([borrador, fechaInicio])
  @@index([grupoPlanId, bloqueIndex])
  @@index([rendimientoId])
  @@index([definicionId], map: "Tarea_definicionId_idx")
  @@index([ocurrenciaPlanId], map: "Tarea_ocurrenciaPlanId_idx")
  @@map("Tarea")
}

model PreventivaExcluidaBorrador {
  id Int @id @default(autoincrement())

  conjuntoId  String
  periodoAnio Int
  periodoMes  Int

  defId             Int?
  origenTareaId     Int?
  tareaProgramadaId Int?
  ocurrenciaPlanId  String?

  descripcion         String
  frecuencia          Frecuencia?
  diaSemanaProgramado DiaSemana?
  prioridad           Int         @default(2)
  duracionMinutos     Int

  fechaObjetivo DateTime

  ubicacionId     Int
  ubicacionNombre String?
  elementoId      Int
  elementoNombre  String?

  supervisorId     String?
  supervisorNombre String?
  operariosIds     String[] @default([])
  operariosNombres String[] @default([])

  motivoTipo    String
  motivoMensaje String?
  estado        String  @default("PENDIENTE")
  metadataJson  Json?

  creadaEn      DateTime  @default(now())
  actualizadaEn DateTime  @updatedAt
  resueltaEn    DateTime?

  @@index([conjuntoId, periodoAnio, periodoMes], map: "PEB_periodo_idx")
  @@index([conjuntoId, periodoAnio, periodoMes, fechaObjetivo], map: "PEB_periodo_fecha_idx")
  @@index([conjuntoId, periodoAnio, periodoMes, estado], map: "PEB_periodo_estado_idx")
  @@index([ocurrenciaPlanId], map: "PEB_ocurrenciaPlanId_idx")
  @@map("PreventivaExcluidaBorrador")
}

/// Inventario persistente de las ocurrencias que una definición debía generar.
/// Es la fuente del informe incluso cuando no existe ninguna Tarea programada.
model PreventivaOcurrenciaPlan {
  id String @id

  conjuntoId  String
  periodoAnio Int
  periodoMes  Int
  borrador    Boolean @default(true)

  defId                Int?
  descripcion          String
  frecuencia           Frecuencia?
  prioridad            Int       @default(2)
  fechaObjetivo        DateTime
  duracionEsperadaMin  Int
  ubicacionId          Int
  ubicacionNombre      String?
  elementoId           Int
  elementoNombre       String?
  operariosEsperadosIds     String[] @default([])
  operariosEsperadosNombres String[] @default([])

  estado        String @default("PENDIENTE")
  motivoCodigo  String?
  motivoMensaje String?
  fechaRealInicio DateTime?
  fechaRealFin    DateTime?

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@index([conjuntoId, periodoAnio, periodoMes, borrador], map: "POP_periodo_idx")
  @@index([defId], map: "POP_defId_idx")
  @@index([fechaObjetivo], map: "POP_fechaObjetivo_idx")
  @@map("PreventivaOcurrenciaPlan")
}

model PreventivaBorradorEvento {
  id Int @id @default(autoincrement())

  conjuntoId  String
  periodoAnio Int
  periodoMes  Int

  tareaId      Int?
  excluidaId   Int?
  tipo         String
  detalle      String?
  metadataJson Json?

  actorId  String?
  actorRol String?

  creadoEn DateTime @default(now())

  @@index([conjuntoId, periodoAnio, periodoMes], map: "PBE_periodo_idx")
  @@index([conjuntoId, periodoAnio, periodoMes, tipo], map: "PBE_periodo_tipo_idx")
  @@map("PreventivaBorradorEvento")
}

/**
 * Bitácora de auditoría transversal.
 * `modulo`, `entidad` y `accion` son texto libre a propósito: añadir auditoría a
 * otro módulo no debe requerir una migración.
 */
model AuditoriaEvento {
  id BigInt @id @default(autoincrement())

  empresaId  Int?
  conjuntoId String?

  modulo    String
  entidad   String
  entidadId String
  accion    String

  actorId     String?
  actorRol    String?
  actorNombre String?
  origen      String  @default("USUARIO")

  descripcion  String?
  datosAntes   Json?
  datosDespues Json?
  metadataJson Json?

  periodoAnio Int?
  periodoMes  Int?

  creadoEn DateTime @default(now())

  @@index([modulo, entidad, entidadId], map: "AUD_entidad_idx")
  @@index([conjuntoId, periodoAnio, periodoMes, modulo], map: "AUD_periodo_idx")
  @@index([creadoEn], map: "AUD_creado_idx")
  @@map("AuditoriaEvento")
}

/**
 * =========================================
 * MODELOS - SOLICITUDES
 * =========================================
 */

model SolicitudTarea {
  id            Int             @id @default(autoincrement())
  descripcion   String
  duracionHoras Int
  estado        EstadoSolicitud @default(PENDIENTE)
  observaciones String?

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit])
  conjuntoId String

  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id])
  ubicacionId Int
  elemento    Elemento  @relation(fields: [elementoId], references: [id])
  elementoId  Int

  empresa   Empresa? @relation(fields: [empresaId], references: [nit])
  empresaId String?
}

model SolicitudInsumo {
  id              Int       @id @default(autoincrement())
  fechaSolicitud  DateTime  @default(now())
  fechaAprobacion DateTime?
  aprobado        Boolean   @default(false)

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit])
  conjuntoId String

  empresa   Empresa? @relation(fields: [empresaId], references: [nit])
  empresaId String?

  insumosSolicitados SolicitudInsumoItem[]
}

model SolicitudInsumoItem {
  id Int @id @default(autoincrement())

  solicitud   SolicitudInsumo @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  solicitudId Int

  insumo   Insumo @relation(fields: [insumoId], references: [id])
  insumoId Int

  cantidad Decimal @db.Decimal(14, 4)

  @@unique([solicitudId, insumoId])
}

model SolicitudMaquinaria {
  id                      Int       @id @default(autoincrement())
  fechaSolicitud          DateTime  @default(now())
  fechaUso                DateTime
  fechaDevolucionEstimada DateTime
  fechaAprobacion         DateTime?

  estado               EstadoSolicitudMaquinaria @default(PENDIENTE)
  observacionRespuesta String?

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit])
  conjuntoId String

  maquinaria   Maquinaria @relation(fields: [maquinariaId], references: [id])
  maquinariaId Int

  responsable Operario @relation(fields: [operarioId], references: [id])
  operarioId  String

  empresa   Empresa? @relation(fields: [empresaId], references: [nit])
  empresaId String?

  maquinariaConjuntoId Int?                @unique
  maquinariaConjunto   MaquinariaConjunto? @relation(fields: [maquinariaConjuntoId], references: [id])

  @@index([conjuntoId, estado])
  @@index([maquinariaId, estado])
}

/**
 * =========================================
 * MODELOS - RENDIMIENTO
 * =========================================
 */

model Rendimiento {
  id                         Int           @id @default(autoincrement())
  actividad                  String
  tipoServicio               TipoServicio
  unidadCalculo              UnidadCalculo
  rendimientoBasePorOperario Decimal       @db.Decimal(14, 4)

  curvaCuadrillaJson        Json?
  factoresJson              Json?
  insumosBaseJson           Json?
  herramientasSugeridasJson Json?

  mermaPorcentaje    Decimal?    @db.Decimal(5, 2)
  frecuenciaSugerida Frecuencia?
  version            Int         @default(1)
  vigenteDesde       DateTime?   @default(now())
  vigenteHasta       DateTime?

  empresa   Empresa? @relation(fields: [empresaId], references: [nit])
  empresaId String?

  definiciones    DefinicionTareaPreventiva[]
  tareasAplicadas RendimientoAplicado[]
  Tarea           Tarea[]

  @@index([tipoServicio, actividad])
  @@index([empresaId])
}

model RendimientoAplicado {
  id Int @id @default(autoincrement())

  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  tareaId Int   @unique

  rendimiento   Rendimiento @relation(fields: [rendimientoId], references: [id])
  rendimientoId Int

  cuadrillaPersonas  Int
  factoresUsadosJson Json?

  areaNumerica     Decimal?       @db.Decimal(14, 4)
  unidadCalculo    UnidadCalculo?
  consumoBaseJson  Json?
  herramientasJson Json?

  rendimientoCalculadoPorPersona Decimal? @db.Decimal(14, 4)
  rendimientoCuadrilla           Decimal? @db.Decimal(14, 4)
  horasCalculadas                Decimal? @db.Decimal(14, 4)
  consumoTotalEstimado           Decimal? @db.Decimal(14, 4)

  creadoEn DateTime @default(now())

  @@index([tareaId])
  @@index([rendimientoId])
}

/**
 * =========================================
 * MODELOS - CALENDARIO (FESTIVOS)
 * =========================================
 */

model Festivo {
  id       Int      @id @default(autoincrement())
  fecha    DateTime @unique
  nombre   String?
  pais     String   @default("CO")
  creadoEn DateTime @default(now())
}

/**
 * =========================================
 * MODELOS - COMERCIO / RESIDENTES
 * =========================================
 */

model Residente {
  id        String               @id
  usuario   Usuario              @relation(fields: [id], references: [id], onDelete: Cascade)
  conjunto  Conjunto             @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String

  tipoUnidad TipoUnidadResidencial
  sector     String?
  unidad     String

  telefonoContacto String?
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  pedidos PedidoApp[] @relation("PedidoAppResidente")

  @@index([conjuntoId])
  @@index([conjuntoId, activo])
  @@map("Residente")
}

model PedidoApp {
  id        Int      @id @default(autoincrement())
  tipo      TipoPedidoApp
  estado    EstadoPedidoInterno @default(BORRADOR)
  estadoWoo String?

  wooOrderId String?  @unique
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  conjuntoId String?
  conjunto   Conjunto? @relation(fields: [conjuntoId], references: [nit])

  residenteId String?
  residente   Residente? @relation("PedidoAppResidente", fields: [residenteId], references: [id])

  total   Decimal @db.Decimal(14, 2)
  moneda  String  @default("COP")
  pagarAhora         Decimal  @default(0) @db.Decimal(14, 2)
  fechaServicio      DateTime? @db.Date
  turnoServicio      String?
  opcionPagoServicio String?
  addonsServicio     Json?
  idempotencyKey     String?   @unique

  entradaInventarioAplicada   Boolean   @default(false)
  entradaInventarioAplicadaEn DateTime?
  puntosAplicados             Boolean   @default(false)
  puntosAplicadosEn           DateTime?
  descuentoPuntos             Decimal   @default(0) @db.Decimal(14, 2)

  beneficioPuntos   BeneficioPuntos? @relation("PedidoBeneficioPuntos", fields: [beneficioPuntosId], references: [id], onDelete: SetNull)
  beneficioPuntosId Int?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  items              PedidoAppItem[]
  movimientosPuntos  MovimientoPuntos[]
  historialEstados   PedidoAppEstadoHistorico[]
  consumosInventario ConsumoInsumo[] @relation("PedidoInventarioEntradas")

  @@index([usuarioId])
  @@index([usuarioId, estado])
  @@index([conjuntoId, estado])
  @@index([wooOrderId])
  @@map("PedidoApp")
}

model PedidoAppItem {
  id        Int       @id @default(autoincrement())
  pedido    PedidoApp @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId  Int

  wooProductId    Int?
  wooVariationId  Int?
  nombreProducto  String
  sku             String?
  cantidad        Decimal @db.Decimal(14, 4)
  precioUnitario  Decimal @db.Decimal(14, 2)
  subtotal        Decimal @db.Decimal(14, 2)
  pagarAhora         Decimal  @default(0) @db.Decimal(14, 2)
  fechaServicio      DateTime? @db.Date
  turnoServicio      String?
  opcionPagoServicio String?
  addonsServicio     Json?

  insumo   Insumo? @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  insumoId Int?

  @@index([pedidoId])
  @@index([insumoId])
  @@map("PedidoAppItem")
}

model PedidoAppEstadoHistorico {
  id Int @id @default(autoincrement())

  pedido   PedidoApp @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId Int

  estadoAnterior EstadoPedidoInterno?
  estadoNuevo    EstadoPedidoInterno

  cambiadoPor    Usuario @relation("PedidoEstadoCambiadoPor", fields: [cambiadoPorId], references: [id])
  cambiadoPorId  String
  cambiadoPorRol String
  motivo         String?
  creadoEn       DateTime @default(now())

  @@index([pedidoId, creadoEn])
  @@index([cambiadoPorId])
  @@map("PedidoAppEstadoHistorico")
}

model ConfigPuntosConjunto {
  id Int @id @default(autoincrement())

  conjunto   Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId String   @unique

  activo                  Boolean @default(false)
  montoPorPuntoResidente  Decimal @default(1000) @db.Decimal(14, 2)
  montoPorPuntoConjunto   Decimal @default(1000) @db.Decimal(14, 2)
  minimoRedencionPuntos   Int     @default(100)

  beneficios  BeneficioPuntos[]
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("ConfigPuntosConjunto")
}

model BeneficioPuntos {
  id Int @id @default(autoincrement())

  config   ConfigPuntosConjunto @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId Int

  nombre         String
  descripcion    String?
  puntosCosto    Int
  valorDescuento Decimal @default(0) @db.Decimal(14, 2)
  activo         Boolean @default(true)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  movimientos MovimientoPuntos[]
  pedidos     PedidoApp[] @relation("PedidoBeneficioPuntos")

  @@index([configId, activo])
  @@map("BeneficioPuntos")
}

model MovimientoPuntos {
  id        Int      @id @default(autoincrement())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String

  pedido   PedidoApp? @relation(fields: [pedidoId], references: [id])
  pedidoId Int?

  conjunto   Conjunto? @relation(fields: [conjuntoId], references: [nit], onDelete: SetNull)
  conjuntoId String?

  beneficio   BeneficioPuntos? @relation(fields: [beneficioId], references: [id], onDelete: SetNull)
  beneficioId Int?

  tipo        TipoMovimientoPuntos
  puntos      Int
  descripcion String?

  creadoEn DateTime @default(now())

  @@index([usuarioId])
  @@index([usuarioId, creadoEn])
  @@index([usuarioId, conjuntoId, creadoEn])
  @@index([pedidoId, tipo])
  @@index([beneficioId])
  @@map("MovimientoPuntos")
}

/**
 * =========================================
 * MODELOS - PLAN ESPERANZA
 * =========================================
 */

model PlanEsperanzaConfig {
  id             Int      @id @default(autoincrement())
  conjunto       Conjunto @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId     String   @unique
  intervaloMeses Int      @default(3)
  actualizadoEn  DateTime @updatedAt

  @@map("PlanEsperanzaConfig")
}

model PlanEsperanza {
  id           Int               @id @default(autoincrement())
  conjunto     Conjunto          @relation(fields: [conjuntoId], references: [nit], onDelete: Cascade)
  conjuntoId   String
  fechaInicio  DateTime          @default(now())
  fechaFin     DateTime?
  completado   Boolean           @default(false)
  creadoEn     DateTime          @default(now())
  diagnosticos DiagnosticoArea[]

  @@index([conjuntoId, completado])
  @@index([conjuntoId, fechaInicio])
  @@map("PlanEsperanza")
}

model DiagnosticoArea {
  id              Int           @id @default(autoincrement())
  planEsperanza   PlanEsperanza @relation(fields: [planEsperanzaId], references: [id], onDelete: Cascade)
  planEsperanzaId Int
  elemento        Elemento      @relation(fields: [elementoId], references: [id])
  elementoId      Int
  urlFoto         String?
  valoracion      Float?
  observaciones   String?
  checklist       Json?
  creadoEn        DateTime      @default(now())

  @@unique([planEsperanzaId, elementoId])
  @@index([elementoId])
  @@map("DiagnosticoArea")
}
