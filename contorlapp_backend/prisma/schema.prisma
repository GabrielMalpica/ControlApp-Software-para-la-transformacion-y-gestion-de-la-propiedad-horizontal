  actorRol String?

  creadoEn DateTime @default(now())

  @@index([conjuntoId, periodoAnio, periodoMes], map: "PBE_periodo_idx")
  @@index([conjuntoId, periodoAnio, periodoMes, tipo], map: "PBE_periodo_tipo_idx")
  @@map("PreventivaBorradorEvento")
}

/**
 * Bitácora de auditoría transversal.
 * `modulo`, `entidad` y `accion` son texto libre a propósito: añadir auditoría a
 * otro módulo no debe requerir una migración.
 */
model AuditoriaEvento {
  id BigInt @id @default(autoincrement())

  empresaId  String?
  conjuntoId String?

  modulo    String
  entidad   String
  entidadId String
  accion    String

  actorId     String?
  actorRol    String?
  actorNombre String?
  origen      String  @default("USUARIO")

  descripcion  String?
  datosAntes   Json?
  datosDespues Json?
  metadataJson Json?

  periodoAnio Int?
  periodoMes  Int?

  creadoEn DateTime @default(now())

  @@index([modulo, entidad, entidadId], map: "AUD_entidad_idx")
  @@index([empresaId, modulo, entidad, entidadId], map: "AUD_empresa_entidad_idx")
  @@index([conjuntoId, periodoAnio, periodoMes, modulo], map: "AUD_periodo_idx")
  @@index([creadoEn], map: "AUD_creado_idx")
  @@map("AuditoriaEvento")
}

