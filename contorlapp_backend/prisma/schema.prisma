  estado    EstadoMaquinaria @default(OPERATIVA)
  condicion CondicionActivo?

  tipoCatalogo   TipoMaquinariaCatalogo? @relation(fields: [tipoCatalogoId], references: [id])
  tipoCatalogoId Int?
  codigoInterno  String?
  alias          String?
  modelo         String?
  serial         String?

  estadoAprobacion EstadoAprobacionActivo @default(APROBADA)
  registroLoteId   String?
  creadoPorId      String?
  creadoEn         DateTime               @default(now())
  aprobadoPorId    String?
  aprobadoEn       DateTime?
  rechazadoPorId   String?
  rechazadoEn      DateTime?
  motivoRechazo    String?
  actualizadoPorId String?
  actualizadoEn    DateTime               @default(now()) @updatedAt
  retiradoPorId    String?
  retiradoEn       DateTime?

