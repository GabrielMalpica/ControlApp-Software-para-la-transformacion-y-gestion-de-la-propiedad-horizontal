# Base de datos y autenticacion de ControlApp
# Prisma usa estos parametros para limitar conexiones por replica.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/controlapp?connection_limit=10&pool_timeout=20
# Con PgBouncer en modo transaction usa el puerto del pool y agrega &pgbouncer=true.
JWT_SECRET=cambia-este-secreto
REDIS_URL=redis://localhost:6379

# WooCommerce. Las credenciales se envian solo por Authorization: Basic.
WOOCOMMERCE_BASE_URL=https://tienda.example.com
WOOCOMMERCE_API_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_SECRET_KEY=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Overrides de audiencia por slugs de categorias/tags, separados por coma.
# La meta _clsr_enabled del plugin sigue siendo la fuente de verdad para servicios.
WOO_RESIDENTE_SLUGS=residente
WOO_CONJUNTO_SLUGS=conjunto,insumos
WOO_SERVICIO_SLUGS=servicios
WOO_INCLUDE_NON_PUBLISHED=false

# Seguridad web. En produccion solo se aceptan estos origenes (separados por coma).
CORS_ALLOWED_ORIGINS=https://app.example.com
FRONTEND_WEB_URL=https://app.example.com

# CTA para comprobantes de servicios (solo digitos, con indicativo de pais).
WOO_WHATSAPP_PHONE=573001112233

# Google Drive. Usa una cuenta de servicio con acceso solo a la carpeta raiz.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}
DRIVE_EVIDENCIAS_ROOT_ID=id-carpeta-raiz-privada

# Solo para scripts de seed; nunca reutilizar en cuentas reales.
SEED_DEFAULT_PASSWORD=cambia-esta-contrasena-temporal
