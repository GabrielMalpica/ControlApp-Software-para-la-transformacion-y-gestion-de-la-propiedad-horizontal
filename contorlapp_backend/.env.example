# Base de datos y autenticacion de ControlApp
# Prisma usa estos parametros para limitar conexiones por replica.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/controlapp?connection_limit=10&pool_timeout=20
# Con PgBouncer en modo transaction usa el puerto del pool y agrega &pgbouncer=true.
JWT_SECRET=cambia-este-secreto
REDIS_URL=redis://localhost:6379

# WooCommerce. Las credenciales se envian solo por Authorization: Basic.
WOOCOMMERCE_BASE_URL=https://tienda.example.com
WOOCOMMERCE_API_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_SECRET_KEY=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Overrides de audiencia por slugs de categorias/tags, separados por coma.
# La meta _clsr_enabled del plugin sigue siendo la fuente de verdad para servicios.
WOO_RESIDENTE_SLUGS=residente
WOO_CONJUNTO_SLUGS=conjunto,insumos
WOO_SERVICIO_SLUGS=servicios
WOO_INCLUDE_NON_PUBLISHED=false

# Seguridad web. En produccion solo se aceptan estos origenes (separados por coma).
CORS_ALLOWED_ORIGINS=https://app.example.com
FRONTEND_WEB_URL=https://app.example.com

# CTA para comprobantes de servicios (solo digitos, con indicativo de pais).
WOO_WHATSAPP_PHONE=573001112233

# Google Drive. Usa una cuenta de servicio con acceso solo a la carpeta raiz.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}
DRIVE_EVIDENCIAS_ROOT_ID=id-carpeta-raiz-privada

# Solo para scripts de seed; nunca reutilizar en cuentas reales.
SEED_DEFAULT_PASSWORD=cambia-esta-contrasena-temporal

# Webhook "Order updated" de WooCommerce (control-pagos-manuales). Sin esto
# el endpoint responde 503 y el estado no se refleja en la app.
WOOCOMMERCE_WEBHOOK_SECRET=cambia-este-secreto-del-webhook

# Contingencia manual (Nequi/Bre-B + comprobante + OCR) mientras se revisa un
# comprobante. Sin configurar, el OCR igual corre pero no puede comparar la
# cuenta de destino.
COMPROBANTE_DESTINO_NEQUI=
COMPROBANTE_DESTINO_BREB=
COMPROBANTE_OCR_IDLE_MS=60000
COMPROBANTE_OCR_TIMEOUT_MS=15000

# Factus Pay (https://pay-developers.factus.com.co/): cobros por QR que
# confirman el pago solo, sin comprobante. Sin estas variables el metodo
# queda deshabilitado (503) y solo queda la contingencia manual de arriba.
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
# Header extra que usa la coleccion de Postman de Factus; no documentado en
# el sitio oficial, pero se envia si esta configurado.
FACTUS_PAY_ACCESS_KEY=
# La vigencia del QR ya no se configura: la app usa la que informa Factus
# (qr_expires_at) o su valor por defecto, 24 h. FACTUS_PAY_EXPIRA_MIN se ignora.
# Limites de monto por cobro (doc de Factus 2026-10-14: 1.000 - 12.100.000 COP).
# Solo cambialos si Factus cambia los suyos.
# FACTUS_PAY_MONTO_MIN_COP=1000
# FACTUS_PAY_MONTO_MAX_COP=12100000
# Como se confirman los pagos: "polling" (por defecto) consulta a Factus
# seguido; "webhook" deja el webhook como via principal y solo hace unas 4
# consultas de respaldo por cobro. En modo webhook, si un pago se confirma sin
# que llegue su aviso, se vuelve solo al sondeo por 24 h (y se avisa).
PAGOS_MODO_CONFIRMACION=polling
# Webhook de Factus Pay (POST /commerce/webhooks/factus-pay). La llave es la
# misma que se registra en el panel de Factus (seccion Webhook) junto con la
# URL https://<api>/commerce/webhooks/factus-pay. Minimo 32 caracteres; sin
# ella el endpoint responde 503. Para rotarla sin cortes: la nueva aqui, la
# vieja en _ANTERIOR, cambiarla en el panel y despues borrar la anterior.
# El aviso nunca confirma un pago por si solo: dispara una consulta a la API.
FACTUS_PAY_WEBHOOK_KEY=
FACTUS_PAY_WEBHOOK_KEY_ANTERIOR=
# Techo de avisos validos por IP cada 15 min (Factus manda uno por pago).
FACTUS_PAY_WEBHOOK_LIMITE_15MIN=1200
# Worker que verifica los cobros pendientes en segundo plano y retoma los
# avisos del webhook sin procesar. "false" lo apaga, por ejemplo en tests.
PAGOS_WORKER_ENABLED=true
PAGOS_WORKER_INTERVALO_MS=5000
PAGOS_WORKER_LOTE=20
# "true" muestra Nequi/Bre-B con comprobante como alternativa si Factus esta
# caido o el monto queda fuera de sus limites (1.000-12.100.000 COP).
PAGOS_CONTINGENCIA_MANUAL=true
# Secreto compartido con el plugin controlapp-factus-pay de la tienda (mismo
# valor que CONTROLAPP_PAGOS_SECRET en wp-config.php). Firma HMAC de las rutas
# /commerce/pagos/woo/*; sin el, responden 503. Genera uno largo y aleatorio.
CONTROLAPP_PAGOS_SECRET=
